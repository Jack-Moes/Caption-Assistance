{
  "manifest_version": 3,
  "name": "Caption assistance Bridge",
  "version": "1.4.0",
  "description": "Sends Caption assistance selections to a bound ChatGPT tab and can stream the answer back to the app.",
  "permissions": ["tabs", "scripting", "alarms", "storage"],
  "host_permissions": [
    "http://127.0.0.1:17632/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["match-engine.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Caption assistance Bridge" }
}
